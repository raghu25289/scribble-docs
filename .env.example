# Password to access the admin dashboard
ADMIN_PASSWORD=change-me

# Upstash Redis (auto-set by Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Discord webhook fired whenever a doc is opened.
# Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Vercel Blob (auto-populated by Vercel when the Blob integration is added)
BLOB_READ_WRITE_TOKEN=
